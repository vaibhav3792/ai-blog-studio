# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Groq (all LLM calls) -------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Planner + section writer
GROQ_MODEL=openai/gpt-oss-120b
# Router + image planner (a separate model has its own rate-limit bucket)
GROQ_FAST_MODEL=openai/gpt-oss-20b
# low | medium | high  (only used for gpt-oss models; "low" saves tokens)
GROQ_REASONING_EFFORT=low
# json_schema (preferred, auto-falls back to json_mode) or json_mode
STRUCTURED_METHOD=json_schema
# Parallel section writers. Keep at 2 on the free tier (8K tokens/min on gpt-oss-120b).
MAX_CONCURRENCY=2

# --- Tavily (web research, optional) -------------------------------------
# Free key (1,000 credits/month): https://app.tavily.com
TAVILY_API_KEY=
MAX_RESEARCH_QUERIES=6

# --- Cloudflare Workers AI (image generation, optional) ------------------
# Account ID: dash.cloudflare.com -> Workers AI -> "Use REST API"
# API token : same screen -> "Create a Workers AI API Token"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGES_ENABLED=true
MAX_IMAGES=2

# --- App ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# DATABASE_URL=sqlite:///./data/blog_studio.db

# --- Visuals --------------------------------------------------------------
# Diagrams are Mermaid code drawn in the browser (free, no key needed).
MAX_DIAGRAMS=2
# AI illustrations use the Cloudflare model below (needs the Cloudflare keys).
# flux-2-klein-4b costs roughly 60 neurons per 1024x576 image (about 150 a day free).
# lucid-origin, phoenix and flux-2-dev cost 30-40x more per image and burn the free allowance fast.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
# Appended to every illustration prompt so the pictures share one look.
# IMAGE_STYLE=clean editorial illustration, soft natural lighting, muted colour palette, uncluttered composition, no text or lettering

# --- Public deployment ----------------------------------------------------
# Anyone with the URL can use your API keys. Set a shared code and a daily cap.
ACCESS_CODE=
DAILY_GENERATION_LIMIT=0
